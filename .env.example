# ── Panel de administrador (obligatorio) ─────────────────────────────
ADMIN_USERNAME=admin
# Genera hash y secreto con:  npm run admin:hash -- "tu-contraseña-larga"
ADMIN_PASSWORD_HASH=
# Mínimo 32 caracteres aleatorios (firma de la cookie de sesión)
SESSION_SECRET=
# Duración de la sesión en horas (1-168). Por defecto 8
SESSION_TTL_HOURS=8

# ── Almacenamiento ───────────────────────────────────────────────────
# netlify-blobs | file. Si se omite: netlify-blobs en Netlify, file en local.
STORAGE_DRIVER=
# Carpeta para el driver "file" (JSON + imágenes). Por defecto .data
DATA_DIR=.data

# ── Sitio ────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
